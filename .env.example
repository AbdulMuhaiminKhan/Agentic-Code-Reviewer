# Copy to .env (never commit .env). Everything below runs on your own machine.

# --- Reviewer model (local Ollama) ---
ACR_PROVIDER=ollama
ACR_MODEL=qwen2.5-coder:7b
ACR_NUM_CTX=16384
ACR_OLLAMA_URL=http://localhost:11434

# --- Judge model for backtesting (local by default; can be a larger local model) ---
ACR_JUDGE_PROVIDER=ollama
ACR_JUDGE_MODEL=qwen2.5-coder:7b

# --- Optional fallback provider. Leave unset: no hosted API is used by default. ---
# ACR_FALLBACK_PROVIDER=
# ACR_FALLBACK_MODEL=

# --- Behaviour ---
ACR_MODE=multi            # multi | single (single = one-prompt baseline for ablations)
ACR_VERIFY=1              # 1 = skeptical second pass on findings, 0 = off
ACR_MIN_CONFIDENCE=0.5
ACR_MAX_CONCURRENCY=1     # one GPU: parallel requests just queue in Ollama
ACR_NUM_PREDICT=2048      # max tokens per answer; stops a looping generation from hanging a review
ACR_SECURITY_PROMPT=v2    # v1 = original security prompt (reproduces the "before schema fix" results)

# --- GitHub personal access token (fine-grained, read-only public repos; add
#     "Pull requests: write" on your own repo only if you use --post) ---
GITHUB_TOKEN=
